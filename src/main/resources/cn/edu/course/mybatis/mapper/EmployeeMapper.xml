<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.course.mybatis.mapper.EmployeeMapper">
    <resultMap id="employeeRow" type="Employee">
        <id property="id" column="emp_id"/>
        <result property="name" column="emp_name"/>
        <result property="gender" column="gender"/>
        <result property="department" column="dept"/>
        <result property="jobTitle" column="post"/>
        <result property="salary" column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="active" column="status"/>
    </resultMap>

    <sql id="employeeColumns">
        emp_id, emp_name, gender, dept, post, salary, hire_date, status
    </sql>

    <select id="findAll" resultMap="employeeRow">
        SELECT <include refid="employeeColumns"/>
        FROM emp
        ORDER BY emp_id
    </select>

    <select id="findById" parameterType="int" resultMap="employeeRow">
        SELECT <include refid="employeeColumns"/>
        FROM emp
        WHERE emp_id = #{id}
    </select>

    <insert id="save" parameterType="Employee" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO emp (emp_name, gender, dept, post, salary, hire_date, status)
        VALUES (#{name}, #{gender}, #{department}, #{jobTitle}, #{salary}, #{hireDate}, #{active})
    </insert>

    <update id="changeProfile" parameterType="Employee">
        UPDATE emp
        SET emp_name = #{name},
            gender = #{gender},
            dept = #{department},
            post = #{jobTitle},
            salary = #{salary},
            hire_date = #{hireDate},
            status = #{active}
        WHERE emp_id = #{id}
    </update>

    <delete id="removeById" parameterType="int">
        DELETE FROM emp
        WHERE emp_id = #{id}
    </delete>

    <select id="search" parameterType="Employee" resultMap="employeeRow">
        SELECT <include refid="employeeColumns"/>
        FROM emp
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="name != null and name != ''">
                AND emp_name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="department != null and department != ''">
                AND dept = #{department}
            </if>
            <if test="jobTitle != null and jobTitle != ''">
                AND post LIKE CONCAT('%', #{jobTitle}, '%')
            </if>
            <if test="active != null">
                AND status = #{active}
            </if>
        </trim>
        ORDER BY emp_id
    </select>

    <update id="patch" parameterType="Employee">
        UPDATE emp
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">emp_name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="department != null">dept = #{department},</if>
            <if test="jobTitle != null">post = #{jobTitle},</if>
            <if test="salary != null">salary = #{salary},</if>
            <if test="hireDate != null">hire_date = #{hireDate},</if>
            <if test="active != null">status = #{active},</if>
        </trim>
        WHERE emp_id = #{id}
    </update>

    <delete id="removeMany">
        DELETE FROM emp
        WHERE emp_id IN
        <foreach collection="keys" item="key" open="(" separator="," close=")">
            #{key}
        </foreach>
    </delete>

    <insert id="addMany" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO emp
        (emp_name, gender, dept, post, salary, hire_date, status)
        VALUES
        <foreach collection="roster" item="item" separator=",">
            (#{item.name}, #{item.gender}, #{item.department}, #{item.jobTitle},
             #{item.salary}, #{item.hireDate}, #{item.active})
        </foreach>
    </insert>

    <select id="chooseByNameOrDepartment" parameterType="Employee" resultMap="employeeRow">
        SELECT <include refid="employeeColumns"/>
        FROM emp
        <where>
            <choose>
                <when test="name != null and name != ''">
                    emp_name = #{name}
                </when>
                <when test="department != null and department != ''">
                    dept = #{department}
                </when>
                <otherwise>
                    status = 1
                </otherwise>
            </choose>
        </where>
        ORDER BY emp_id
    </select>
</mapper>
