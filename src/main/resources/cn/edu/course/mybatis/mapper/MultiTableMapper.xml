<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.course.mybatis.mapper.MultiTableMapper">

    <!-- 图书基础映射：多张关联 resultMap 复用，避免重复书写字段 -->
    <resultMap id="bookBase" type="bookRecord">
        <id column="book_id" property="id"/>
        <result column="book_title" property="title"/>
        <result column="binding" property="binding"/>
        <result column="publisher" property="publisher"/>
        <result column="book_publisher_id" property="publisherId"/>
        <result column="category" property="category"/>
        <result column="price" property="price"/>
        <result column="publish_date" property="publishedOn"/>
        <result column="status" property="saleStatus"/>
        <result column="book_create_time" property="createTime"/>
        <result column="book_update_time" property="updateTime"/>
        <result column="book_deleted" property="deleted"/>
        <result column="book_version" property="version"/>
    </resultMap>

    <sql id="bookJoinColumns">
        e.book_id, e.book_title, e.binding, e.publisher, e.publisher_id AS book_publisher_id, e.category, e.price, e.publish_date, e.status,
        e.create_time AS book_create_time, e.update_time AS book_update_time,
        e.deleted AS book_deleted, e.version AS book_version
    </sql>

    <!-- ============ 一对一：图书 ←→ 书籍详情（association 联合查询） ============
         一条 SQL LEFT JOIN 同时取出图书与详情，
         详情列与图书列重名（book_id）时须起别名区分。 -->
    <resultMap id="bookWithDetailMap" type="bookRecord" extends="bookBase">
        <association property="detail" javaType="bookDetailRecord" notNullColumn="detail_id">
            <id column="detail_id" property="detailId"/>
            <result column="book_detail_book_id" property="bookId"/>
            <result column="isbn" property="isbn"/>
            <result column="print_date" property="printDate"/>
        </association>
    </resultMap>
    <select id="findBookWithDetail" resultMap="bookWithDetailMap">
        SELECT <include refid="bookJoinColumns"/>,
               i.detail_id, i.book_id AS book_detail_book_id, i.isbn, i.print_date
        FROM book e
        LEFT JOIN book_detail i ON i.book_id = e.book_id
        WHERE e.book_id = #{bookId} AND e.deleted = 0
    </select>

    <!-- 多对一：多本图书通过 publisher_id 关联到同一个出版社。 -->
    <resultMap id="bookWithPublisherMap" type="bookRecord" extends="bookBase">
        <association property="publisherInfo" javaType="publisherRecord" notNullColumn="publisher_id">
            <id column="publisher_id" property="publisherId"/>
            <result column="publisher_name" property="publisherName"/>
            <result column="city" property="city"/>
            <result column="deleted" property="deleted"/>
        </association>
    </resultMap>
    <select id="findBookWithPublisher" resultMap="bookWithPublisherMap">
        SELECT <include refid="bookJoinColumns"/>, d.publisher_id, d.publisher_name, d.city, d.deleted
        FROM book e
        LEFT JOIN publisher d ON d.publisher_id = e.publisher_id AND d.deleted = 0
        WHERE e.book_id = #{bookId} AND e.deleted = 0
    </select>

    <!-- ============ 一对多：出版社 ← 图书列表（collection 联合查询） ============
         publisher 一行与多条 book 行连接，MyBatis 依据 <id> 列自动去重聚合，
         把多行图书归入同一出版社的 books 集合。 -->
    <resultMap id="publisherWithBooksMap" type="publisherRecord">
        <id column="publisher_id" property="publisherId"/>
        <result column="publisher_name" property="publisherName"/>
        <result column="city" property="city"/>
        <result column="deleted" property="deleted"/>
        <collection property="books" resultMap="bookBase" notNullColumn="book_id"/>
    </resultMap>
    <select id="findPublisherWithBooks" resultMap="publisherWithBooksMap">
        SELECT d.publisher_id, d.publisher_name, d.city, d.deleted,
               <include refid="bookJoinColumns"/>
        FROM publisher d
        LEFT JOIN book e ON e.publisher_id = d.publisher_id AND e.deleted = 0
        WHERE d.publisher_id = #{publisherId} AND d.deleted = 0
        ORDER BY e.book_id
    </select>

    <!-- ============ 多对多（方向一）：作者 → 图书 ============
         三表连接：author ← book_author → book，
         中间表提供两侧外键，book_author 无独立实体。 -->
    <resultMap id="authorWithBooksMap" type="authorRecord">
        <id column="author_id" property="authorId"/>
        <result column="author_name" property="authorName"/>
        <result column="birth_date" property="birthDate"/>
        <collection property="books" resultMap="bookBase" notNullColumn="book_id"/>
    </resultMap>
    <select id="findAuthorWithBooks" resultMap="authorWithBooksMap">
        SELECT p.author_id, p.author_name, p.birth_date,
               <include refid="bookJoinColumns"/>
        FROM author p
        LEFT JOIN book_author ep ON ep.author_id = p.author_id
        LEFT JOIN book e ON e.book_id = ep.book_id AND e.deleted = 0
        WHERE p.author_id = #{authorId}
        ORDER BY e.book_id
    </select>

    <!-- ============ 多对多（方向二）：图书 → 作者 ============
         同一组表的反向查询：book ← book_author → author，
         子列均不重名，collection 可直接内联书写。 -->
    <resultMap id="bookWithAuthorsMap" type="bookRecord" extends="bookBase">
        <collection property="authors" ofType="authorRecord" notNullColumn="author_id">
            <id column="author_id" property="authorId"/>
            <result column="author_name" property="authorName"/>
            <result column="birth_date" property="birthDate"/>
        </collection>
    </resultMap>
    <select id="findBookWithAuthors" resultMap="bookWithAuthorsMap">
        SELECT <include refid="bookJoinColumns"/>,
               p.author_id, p.author_name, p.birth_date
        FROM book e
        LEFT JOIN book_author ep ON ep.book_id = e.book_id
        LEFT JOIN author p ON p.author_id = ep.author_id
        WHERE e.book_id = #{bookId} AND e.deleted = 0
        ORDER BY p.author_id
    </select>
</mapper>
